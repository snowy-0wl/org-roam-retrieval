(ert-deftest org-roam-retrieval-ui-status-shows-coverage-and-stays-closed ()
  (org-roam-retrieval-test-ui
    (unwind-protect
        (progn
          (org-roam-retrieval-status)
          (let ((callback (nth 3 (car org-roam-retrieval-test--calls))))
            (funcall callback '((readiness . ((lexical . t) (semantic . :false)))
                                (coverage . ((sources . 2) (chunks . 4) (embedded_chunks . 0)))
                                (errors . (((path . "/tmp/broken.pdf") (error . "No extractable text"))))))
            (with-current-buffer "*Org-roam retrieval status*"
              (should buffer-read-only)
              (should (string-match-p "Sources: 2" (buffer-string)))
              (should (string-match-p "No extractable text" (buffer-string))))
            (quit-window nil (get-buffer-window "*Org-roam retrieval status*" t))
            (funcall callback '((coverage . ((sources . 3)))))
            (should-not (get-buffer-window "*Org-roam retrieval status*" t))))
      (when-let* ((buffer (get-buffer "*Org-roam retrieval status*"))) (kill-buffer buffer)))))

(ert-deftest org-roam-retrieval-ui-repair-previews-before-rebuild ()
  (org-roam-retrieval-test-ui
    (unwind-protect
        (let (reviewed)
          (org-roam-retrieval-repair)
          (should (eq t (alist-get 'dry_run (nth 2 (car org-roam-retrieval-test--calls)))))
          (cl-letf (((symbol-function 'yes-or-no-p)
                     (lambda (_question)
                       (with-current-buffer "*Org-roam retrieval status*"
                         (setq reviewed (string-match-p "source files, graph" (buffer-string))))
                       t)))
            (funcall (nth 3 (car org-roam-retrieval-test--calls))
                     '((plan . ((preserves . ("source files" "graph")))))))
          (should reviewed)
          (should (eq :false (alist-get 'dry_run (nth 2 (car org-roam-retrieval-test--calls)))))
          (with-current-buffer source (should (equal "source text" (buffer-string)))))
      (when-let* ((buffer (get-buffer "*Org-roam retrieval status*"))) (kill-buffer buffer)))))

(ert-deftest org-roam-retrieval-ui-incomplete-index-refreshes-without-starvation ()
  (org-roam-retrieval-test-ui
    (let ((session (with-current-buffer source (org-roam-retrieval-search "x"))))
      (org-roam-retrieval--worker-event
       "progress" '((state . "running") (stage . "extracting")
                    (coverage . ((sources . 2) (chunks . 3) (embedded_chunks . 0)))))
      (let ((timer org-roam-retrieval--refresh-timer))
        (should (timerp timer))
        (org-roam-retrieval--worker-event
         "progress" '((state . "running") (stage . "extracting")
                      (coverage . ((sources . 4) (chunks . 5) (embedded_chunks . 0)))))
        (should (eq timer org-roam-retrieval--refresh-timer))
        (cancel-timer timer))
      (org-roam-retrieval--refresh-visible)
      (should (= 2 (length org-roam-retrieval-test--calls)))
      (should (equal "lexical" (alist-get 'mode (nth 2 (car org-roam-retrieval-test--calls)))))
      (org-roam-retrieval--worker-event
       "status" '((stage . "embedding")
                  (coverage . ((sources . 4) (chunks . 5) (embedded_chunks . 2)))))
      (cancel-timer org-roam-retrieval--refresh-timer)
      (org-roam-retrieval--refresh-visible)
      (should (equal "hybrid" (alist-get 'mode (nth 2 (car org-roam-retrieval-test--calls)))))
      (with-current-buffer (org-roam-retrieval-session-buffer session) (org-roam-retrieval-ui-quit))
      (org-roam-retrieval--refresh-visible)
      (should (= 3 (length org-roam-retrieval-test--calls))))))

