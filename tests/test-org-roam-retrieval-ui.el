(ert-deftest org-roam-retrieval-ui-epub-location-matches-member-and-fragment ()
  (let* ((path (make-temp-file "roam-book-" nil ".epub"))
         (buffer (generate-new-buffer " *roam-epub-fixture*"))
         (member "OEBPS/Text/chapter.xhtml") seen-index seen-target)
    (unwind-protect
        (save-window-excursion
          (with-current-buffer buffer
            (setq major-mode 'nov-mode)
            (setq-local nov-work-dir "/tmp/roam-epub/")
            (setq-local nov-documents
                        (vector '(toc . "/tmp/roam-epub/toc.xhtml")
                                (cons 'chapter (concat nov-work-dir member)))))
          (cl-letf (((symbol-function 'find-file-noselect) (lambda (&rest _) buffer))
                    ((symbol-function 'nov-goto-document) (lambda (index) (setq seen-index index)))
                    ((symbol-function 'nov-visit-relative-file)
                     (lambda (file target) (setq seen-target (list file target)))))
            (org-roam-retrieval-ui-open-location
             path `((kind . "epub-section") (href . ,member) (spine_index . 0)
                    (fragment . "paragraph-three"))))
          (should (= 1 seen-index))
          (should (equal '("" "paragraph-three") seen-target)))
      (kill-buffer buffer) (delete-file path))))

(ert-deftest org-roam-retrieval-mx-candidates-follow-source-context ()
  (with-temp-buffer
    (fundamental-mode)
    (should (command-completion-default-include-p 'org-roam-retrieval-search (current-buffer)))
    (should (command-completion-default-include-p 'org-roam-retrieval-status (current-buffer)))
    (should-not (command-completion-default-include-p 'org-roam-retrieval-related (current-buffer)))
    (insert "Useful source text")
