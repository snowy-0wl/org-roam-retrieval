(ert-deftest org-roam-retrieval-ui-semantic-update-keeps-selection-and-session ()
  (org-roam-retrieval-test-ui
    (let* ((session (with-current-buffer source (org-roam-retrieval-search "x")))
           (id (org-roam-retrieval-session-last-rpc-id session))
           (a (org-roam-retrieval-test-result "a"))
           (b (org-roam-retrieval-test-result "b")))
      (funcall (nth 3 (car org-roam-retrieval-test--calls))
               `((results . (,a ,b)) (semantic_pending . t)))
      (with-current-buffer (org-roam-retrieval-session-buffer session)
        (org-roam-retrieval-ui-next)
        (should (string-match-p "semantic search completes" (buffer-string))))
      (org-roam-retrieval--worker-event
       "search-update" `((request_id . ,id) (result . ((results . (,b ,a))))))
      (with-current-buffer (org-roam-retrieval-session-buffer session)
        (should (equal "b" (alist-get 'id (org-roam-retrieval-ui--current-result)))))
      (with-current-buffer (org-roam-retrieval-session-buffer session) (org-roam-retrieval-ui-cancel))
      (should (member id org-roam-retrieval-test--cancelled))
      (org-roam-retrieval--worker-event
       "search-update" `((request_id . ,id) (result . ((results . (,a))))))
      (should (= 2 (length (org-roam-retrieval-session-results session)))))))

