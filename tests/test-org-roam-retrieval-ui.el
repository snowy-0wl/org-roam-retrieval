;;; test-org-roam-retrieval-ui.el --- Retrieval behavior checks -*- lexical-binding: t; -*-
(require 'ert)
(require 'cl-lib)
(require 'org-roam-retrieval)

(defvar org-roam-retrieval-test--calls)
(defvar org-roam-retrieval-test--cancelled)

(defmacro org-roam-retrieval-test-ui (&rest body)
  (declare (indent 0))
  `(let ((source (generate-new-buffer " *retrieval-test-source*"))
         (org-roam-retrieval-test--calls nil)
         (org-roam-retrieval-test--cancelled nil)
         (org-roam-retrieval--sessions nil)
         (org-roam-retrieval--refresh-timer nil)
         (org-roam-retrieval--coverage-key nil)
         (org-roam-retrieval--semantic-ready-p nil)
         (org-roam-retrieval--refresh-lexical-p nil)
         (org-roam-retrieval-roots '(((id . "org-roam") (path . "/tmp")))))
     (unwind-protect
         (cl-letf (((symbol-function 'org-roam-retrieval-client-request)
                    (lambda (method params success &optional error)
                      (let ((id (1+ (length org-roam-retrieval-test--calls))))
                        (push (list id method params success error) org-roam-retrieval-test--calls)
                        id)))
                   ((symbol-function 'org-roam-retrieval-client-cancel)
                    (lambda (id) (push id org-roam-retrieval-test--cancelled))))
           (with-current-buffer source (org-mode) (insert "source text"))
           ,@body)
       (when (timerp org-roam-retrieval--refresh-timer)
         (cancel-timer org-roam-retrieval--refresh-timer))
       (when (buffer-live-p source) (kill-buffer source))
       (dolist (buffer (buffer-list))
         (when (or (string-prefix-p "*Org-roam retrieval:  *retrieval-test-source*" (buffer-name buffer))
                   (string-prefix-p "*Org-roam insertion:  *retrieval-test-source*" (buffer-name buffer)))
           (kill-buffer buffer))))))

(defun org-roam-retrieval-test-result (id &optional title)
  `((id . ,id) (source_id . "source") (path . "/tmp/note.org")
    (title . ,(or title id)) (excerpt . "A relevant passage")
    (locator . ((kind . "text-range") (line . 2)))))

(ert-deftest org-roam-retrieval-ui-library-request-keeps-query-and-contract ()
  (org-roam-retrieval-test-ui
    (let ((session (with-current-buffer source (org-roam-retrieval-search "שלום cosmos"))))
      (pcase-let ((`(,_ ,method ,params ,success ,_) (car org-roam-retrieval-test--calls)))
        (should (equal method "search"))
        (should (equal (alist-get 'task params) "search"))
        (should (equal (alist-get 'scope params) "query"))
        (should (equal (alist-get 'text params) "שלום cosmos"))
        (funcall success `((results . ,(list (org-roam-retrieval-test-result "a" "שלום"))) (generation . 1))))
      (with-current-buffer (org-roam-retrieval-session-buffer session)
        (should buffer-read-only)
        (should (equal (alist-get 'id (org-roam-retrieval-ui--current-result)) "a"))
        (should (string-match-p "שלום" (buffer-string)))
        (should (string-match-p "library query" (buffer-string)))))))

(ert-deftest org-roam-retrieval-ui-related-node-scope-uses-unsaved-body ()
  (org-roam-retrieval-test-ui
    (with-current-buffer source
      (erase-buffer)
      (insert ":PROPERTIES:\n:ID: file-id\n:END:\n#+title: Root\n* Parent\n:PROPERTIES:\n:ID: parent-id\n:END:\nparent body\n** Child\nchild unsaved text\n* Sibling\nunrelated sibling\n")
      (goto-char (point-min)) (search-forward "child unsaved")
      (org-roam-retrieval-related)
      (let ((params (nth 2 (car org-roam-retrieval-test--calls))))
        (should (equal (alist-get 'scope params) "node"))
        (should (equal (alist-get 'node_id (alist-get 'source params)) "parent-id"))
        (should (string-match-p "child unsaved text" (alist-get 'text params)))
        (should-not (string-match-p "unrelated sibling" (alist-get 'text params)))
        (should (equal (alist-get 'root_ids params) ["org-roam"]))))))

(ert-deftest org-roam-retrieval-ui-narrowed-scope-is-preserved ()
  (org-roam-retrieval-test-ui
    (with-current-buffer source
      (erase-buffer) (insert "outside\ninside\noutside\n")
      (narrow-to-region 9 15)
      (org-roam-retrieval-related t)
      (let ((params (nth 2 (car org-roam-retrieval-test--calls))))
        (should (equal (alist-get 'scope params) "region"))
        (should (equal (alist-get 'text params) "inside"))
        (should-not (alist-get 'root_ids params)))
      (should (buffer-narrowed-p)))))

