    (should-not (command-completion-default-include-p 'org-roam-retrieval-insert-list (current-buffer)))
    (should-not (command-completion-default-include-p 'org-roam-retrieval-ui-open (current-buffer)))
    (org-mode)
    (should (command-completion-default-include-p 'org-roam-retrieval-insert-list (current-buffer)))
    (should (command-completion-default-include-p 'org-similarity-insert-list (current-buffer)))
    (setq buffer-read-only t)
    (should-not (command-completion-default-include-p 'org-roam-retrieval-insert-list (current-buffer)))
    (should-not (command-completion-default-include-p 'org-similarity-insert-list (current-buffer)))
    (should (command-completion-default-include-p 'org-roam-retrieval-related (current-buffer)))))

