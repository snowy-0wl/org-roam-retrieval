                   (locator . ((kind . "text-range") (line . 9)))))
         (link (org-roam-retrieval-ui-result-link result)) opened)
    (string-match "roam-source:\\([^]]+\\)" link)
    (cl-letf (((symbol-function 'org-roam-retrieval-ui-open-location)
               (lambda (path locator &optional _) (setq opened (list path locator)))))
      (org-roam-retrieval-ui-follow-source (match-string 1 link) nil))
    (should (equal (car opened) "/tmp/שלום.pdf"))
    (should (= 9 (alist-get 'line (cadr opened))))))

